/target
**/*.rs.bk
web/**/node_modules/
web/**/dist/
*.log
/tests/bench/results/
/tests/bench/archive/
/tests/crash/run/
__pycache__/
var/
tools/*
# 独立 workspace 工具是仓库交付物(不参与主构建/主锁文件),按需例外:
!tools/runtime-ab/
!tools/sbom/
!tools/package/
*.tsbuildinfo
# 打包产出与独立 crate 的构建产物不入库:
tools/package/dist/
tools/sbom/target/
tools/runtime-ab/target/
docs/site/site/

# 明文凭据不入库(模板见 config.example.json;运行时由部署方生成)
web/server/config.json

# 本地运行产物(init 向导默认落仓库根;含 admin token / TLS 私钥)
/fasts3-data/
/fasts3.toml
*.pid
# KMS 密钥托管本地数据(M20/A1:transit 存储、unseal key、service token、audit)
deploy/vault/data/
deploy/vault/init-keys.json
deploy/vault/token_file
deploy/vault/audit.log
