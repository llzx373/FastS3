# FastS3 容器构建上下文忽略(M6/K2)
# 构建阶段只依赖:源码 + 锁文件 + 部署资产;排除构建产物/缓存/本地数据。

# Rust 构建缓存与产物
target/
**/*.rs.bk

# Node / pnpm
web/node_modules/
web/server/node_modules/
web/console/node_modules/
web/**/dist/          # web dist 在镜像内重建,不拷贝宿主产物

# 本地数据与运行痕迹
var/
*.log
tests/bench/results/
tests/bench/archive/
tests/crash/run/

# VCS / 编辑器 / 系统
.git/
.gitignore
.github/
__pycache__/
*.swp
.DS_Store

# 打包产物(本目录指令构建时无需进入镜像)
dist/
rpmbuild/
*.tar.gz
*.deb
*.rpm
*.sig
*.minisig
SBOM.json